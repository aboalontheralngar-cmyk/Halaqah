# Public values compiled into the browser bundle. Never put service_role here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Canonical public frontend origin. Production must be HTTPS and must also be
# added to Supabase Auth -> URL Configuration.
NEXT_PUBLIC_APP_URL=https://YOUR_PUBLIC_APP_DOMAIN
